{
  "build": {
    "appId": "com.nodeyml.configtool",
    "directories": {
      "output": "dist"
    },
    "files": [
      "www/**/*",
      "electron/**/*",
      "package.json"
    ],
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "artifactName": "node-yml-config-tool-${version}-${arch}-setup.${ext}",
      "createDesktopShortcut": true,
      "oneClick": false
    },
    "portable": {
      "artifactName": "node-yml-config-tool-${version}-${arch}-portable.${ext}"
    },
    "productName": "Clash YML 配置工具",
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0"
  },
  "description": "Clash YML 配置工具 — 管理 Clash / mihomo 节点、分组与订阅，导出完整 YAML。初始为空，不含任何预置数据。",
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "license": "MIT",
  "main": "electron/main.js",
  "name": "node-yml-config-tool",
  "scripts": {
    "build:win": "electron-builder --win --publish never",
    "cap:add:android": "cap add android",
    "cap:open:android": "cap open android",
    "cap:sync": "cap sync",
    "serve": "npx --yes serve www -p 8080",
    "start": "electron ."
  },
  "version": "1.0.6"
}